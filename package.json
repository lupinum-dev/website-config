{
  "name": "@lupinum/website-config",
  "version": "0.1.0",
  "description": "Shared Vite+ and template ESLint configuration for Lupinum Nuxt websites.",
  "keywords": [
    "nuxt",
    "vite-plus",
    "oxlint",
    "eslint",
    "shadcn",
    "lupinum"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "homepage": "https://github.com/lupinum-dev/website-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/website-config.git"
  },
  "bugs": {
    "url": "https://github.com/lupinum-dev/website-config/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || ^26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup src/index.ts src/eslint.ts --format esm --dts --watch",
    "build": "tsup src/index.ts src/eslint.ts --format esm --dts --clean && publint",
    "lint": "eslint . && node scripts/lint-changesets.mjs",
    "format": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/audit-deps.mjs",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "vite-plus": "1.0.0"
  },
  "dependencies": {
    "@shadcn/lint": "0.2.0",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "typescript-eslint": "8.71.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "26.1.1",
    "eslint": "^10.4.1",
    "pkg-pr-new": "0.0.87",
    "publint": "0.3.24",
    "tailwindcss": "4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite-plus": "1.0.0",
    "vitest": "^4.1.8"
  }
}
